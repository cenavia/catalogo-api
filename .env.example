# App
NODE_ENV=development
PORT=3000
# Corta peticiones que tarden más de N ms (408)
REQUEST_TIMEOUT_MS=5000

# Base de datos (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=catalogo
# true SOLO en desarrollo: TypeORM crea/altera tablas a partir de las entidades
DB_SYNC=true

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h

# Admin de demo (se crea al arrancar si no existe; déjalas vacías para desactivarlo)
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin12345
